#!/bin/sh
set -eu

if [ "${1-}" = "debug" ] && [ "${2-}" = "models" ]; then
  if [ "${CODEX_POLICY_REJECT_CATALOG-}" = 1 ]; then
    printf '%s\n' 'fixture: CLI rejects catalog' >&2
    exit 65
  fi
  if grep -E '^[[:space:]]*model_catalog_json[[:space:]]*=' "$CODEX_HOME/config.toml" >/dev/null 2>&1 &&
    [ -f "$CODEX_HOME/model-catalog.json" ]; then
    exec jq . "$CODEX_HOME/model-catalog.json"
  fi
  if [ "${CODEX_POLICY_REQUIRE_UNPINNED-}" = 1 ] &&
    grep -E '^[[:space:]]*model_catalog_json[[:space:]]*=' "$CODEX_HOME/config.toml" >/dev/null 2>&1; then
    printf '%s\n' 'fake codex received a still-pinned discovery config' >&2
    exit 65
  fi
  exec jq . "$CODEX_POLICY_TEST_ROOT/tests/fixtures/live-catalog.json"
fi

if [ "${1-}" = "--version" ]; then
  printf '%s\n' 'codex-cli test'
  exit 0
fi

if [ "${1-}" = "app-server" ] && [ "${2-}" = "daemon" ] && [ "${3-}" = "version" ]; then
  case "${CODEX_POLICY_DAEMON_STATUS-}" in
    running) printf '%s\n' '{"status":"running","cliVersion":"test","appServerVersion":"test"}'; exit 0 ;;
    stopped) printf '%s\n' '{"status":"stopped","cliVersion":"test","appServerVersion":"test"}'; exit 0 ;;
    *) printf '%s\n' 'Error: failed to connect to the app-server control socket' >&2; exit 1 ;;
  esac
fi

if [ "${1-}" = "app-server" ] && [ "${2-}" = "daemon" ] && [ "${3-}" = "restart" ]; then
  if [ "${CODEX_POLICY_DAEMON_RESTART_FAILS-}" = 1 ]; then
    printf '%s\n' 'Error: failed to restart the app-server daemon' >&2
    exit 1
  fi
  if [ -n "${CODEX_POLICY_DAEMON_LOG-}" ]; then
    printf '%s\n' 'restart' >>"$CODEX_POLICY_DAEMON_LOG"
  fi
  printf '%s\n' '{"status":"restarted","cliVersion":"test","appServerVersion":"test"}'
  exit 0
fi

printf '%s\n' "unexpected fake codex arguments: $*" >&2
exit 64
